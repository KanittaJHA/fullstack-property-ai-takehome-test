# Copy to backend/.env.local and fill in. Never commit .env.local.

# Server
HOST=127.0.0.1
PORT=4000
# In production: NODE_ENV=production and the HTTPS frontend origin (enables Secure cookies).
FRONTEND_ORIGIN=http://localhost:3100

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Team pages (/admin, /leads, /knowledge)
# ADMIN_ACCESS_CODE: exactly 8 characters. ADMIN_SESSION_SECRET: generate with openssl rand -hex 32
ADMIN_ACCESS_CODE=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------------------------
# AI provider (Task 1 property matching, Task 2 sales chat)
#
# 1. Choose a provider for each task. Values: gemini | openai | anthropic
#      AI_PROVIDER       -> Task 1, property matching
#      CHAT_AI_PROVIDER  -> Task 2, sales chat
#
# 2. Fill in the key of each provider you chose (keys of unused providers can stay empty):
#      gemini     -> GEMINI_API_KEY     and the model in GEMINI_MODEL
#      openai     -> OPENAI_API_KEY     and the model in OPENAI_MODEL
#      anthropic  -> ANTHROPIC_API_KEY  and the model in ANTHROPIC_MODEL
#
# 3. Optional: CHAT_MODEL gives Task 2 a different model from the same provider as CHAT_AI_PROVIDER.
#
# Keys: paste your own key after the = sign. Leave a key empty rather than typing placeholder
# text: an empty key gives a clear AI_NOT_CONFIGURED error, while placeholder text is sent to the
# provider and rejected as an invalid key.
#
# Gemini is set to gemini-3.5-flash-lite, the model this project was tested on; it works with a
# free Gemini key. The OpenAI and Claude models below are each provider's most capable model and
# may need a paid key. An empty model uses the default in brackets.
# Only the chosen provider is called; there is no automatic fallback to another provider.
# ---------------------------------------------------------------------------------------------
AI_PROVIDER=gemini
CHAT_AI_PROVIDER=gemini
CHAT_MODEL=

# Gemini (default model gemini-3.5-flash-lite). A more capable model, e.g. gemini-4-argon, may need a paid key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI, Responses API with Structured Outputs (default model gpt-4.1-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Claude, Messages API with structured outputs (default model claude-haiku-4-5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Task 1 matching cache, per server process (positive integers; a restart clears it)
MATCH_CACHE_MAX_ENTRIES=100
MATCH_CACHE_TTL_MS=300000

# Task 3: the n8n lead workflow. The URL is its production webhook; the secret is a long random value
# (openssl rand -hex 32) that the webhook checks in the X-Lead-Webhook-Secret header. Keep both server-side.
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_SECRET=
